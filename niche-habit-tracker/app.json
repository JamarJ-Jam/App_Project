{
  "expo": {
    "name": "My Chawgee",
    "slug": "my-chawgee",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon/Dark primary.png",
    "scheme": "com.mychawgee",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#021739",
        "foregroundImage": "./assets/app-icon/chawgee-adaptive-foreground.png",
        "backgroundImage": "./assets/app-icon/chawgee-adaptive-background.png",
        "monochromeImage": "./assets/app-icon/chawgee-monochrome.png"
      },
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "predictiveBackGestureEnabled": false,
      "package": "com.jamarjsteam.mychawgee"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-video",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "04b50a30-e4fc-4efc-911c-cf91890c6255"
      }
    },
    "owner": "jamar-js-team"
  }
}
